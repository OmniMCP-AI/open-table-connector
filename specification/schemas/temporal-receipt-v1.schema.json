{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-connectors.dev/schemas/temporal-receipt-v1.schema.json",
  "title": "Temporal execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "neutral_receipt",
    "descriptor_hash",
    "requested_range",
    "observed_range",
    "output_order",
    "execution_location",
    "resource_bounds",
    "examined_rows",
    "examined_bytes",
    "returned_rows",
    "returned_bytes",
    "elapsed_ms",
    "snapshot_reference",
    "plan_schema_version",
    "portable_plan_hash"
  ],
  "properties": {
    "schema_version": {"const": "otc.temporal-receipt/v1"},
    "neutral_receipt": {"$ref": "#/$defs/neutralReceipt"},
    "descriptor_hash": {"$ref": "#/$defs/hash"},
    "requested_range": {"$ref": "#/$defs/nullableTimeRange"},
    "observed_range": {"$ref": "#/$defs/nullableTimeRange"},
    "output_order": {
      "type": "array",
      "items": {"$ref": "#/$defs/orderKey"}
    },
    "execution_location": {"enum": ["provider", "connector"]},
    "resource_bounds": {"$ref": "#/$defs/resourceBounds"},
    "examined_rows": {"type": "integer", "minimum": 0},
    "examined_bytes": {"type": "integer", "minimum": 0},
    "returned_rows": {"type": "integer", "minimum": 0},
    "returned_bytes": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "snapshot_reference": {"type": ["string", "null"], "minLength": 1},
    "plan_schema_version": {"const": "otc.portable-temporal-plan/v1"},
    "portable_plan_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "uri": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {"value": {"type": "string", "minLength": 1}}
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"}
      }
    },
    "nullableTimeRange": {
      "oneOf": [
        {"$ref": "#/$defs/timeRange"},
        {"type": "null"}
      ]
    },
    "orderKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "direction": {"enum": ["asc", "desc"]}
      }
    },
    "resourceBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rows", "max_bytes", "max_duration_ms"],
      "properties": {
        "max_rows": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "max_duration_ms": {"type": "integer", "minimum": 1}
      }
    },
    "connectorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "connector_version", "contract_version"],
      "properties": {
        "connector_id": {"type": "string", "minLength": 1},
        "connector_version": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1}
      }
    },
    "capabilityIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "capability_version": {"type": "string", "minLength": 1}
      }
    },
    "baseConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "record_id_field", "key_fields", "ordinal_snapshot_id"],
      "properties": {
        "mode": {"const": "base"},
        "record_id_field": {"type": ["string", "null"]},
        "key_fields": {"type": "array", "items": {"type": "string"}},
        "ordinal_snapshot_id": {"type": ["string", "null"]}
      }
    },
    "sheetConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sheet", "header_rows", "first_data_row"],
      "properties": {
        "mode": {"const": "sheet"},
        "sheet": {"type": ["string", "integer"]},
        "header_rows": {"type": "integer", "minimum": 1},
        "first_data_row": {"type": "integer", "minimum": 1}
      }
    },
    "neutralReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "connector",
        "capability",
        "operation_id",
        "safe_uri",
        "mode",
        "source_revision",
        "schema_fingerprint",
        "content_fingerprint",
        "coordinate_convention",
        "row_count",
        "batch_count",
        "vendor_receipt_ref"
      ],
      "properties": {
        "contract_version": {"type": "string", "minLength": 1},
        "connector": {"$ref": "#/$defs/connectorIdentity"},
        "capability": {"$ref": "#/$defs/capabilityIdentity"},
        "operation_id": {"type": "string", "minLength": 1},
        "safe_uri": {"$ref": "#/$defs/uri"},
        "mode": {"enum": ["base", "sheet"]},
        "source_revision": {"type": "string", "minLength": 1},
        "schema_fingerprint": {"type": "string", "minLength": 1},
        "content_fingerprint": {"type": "string", "minLength": 1},
        "coordinate_convention": {
          "oneOf": [
            {"$ref": "#/$defs/baseConvention"},
            {"$ref": "#/$defs/sheetConvention"}
          ]
        },
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "batch_count": {"type": ["integer", "null"], "minimum": 0},
        "vendor_receipt_ref": {"type": ["string", "null"]}
      }
    }
  }
}

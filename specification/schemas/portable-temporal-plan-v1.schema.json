{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-connectors.dev/schemas/portable-temporal-plan-v1.schema.json",
  "title": "Portable temporal plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "descriptor_hash",
    "relation",
    "required_capabilities",
    "resource_bounds",
    "operation",
    "output_order",
    "result_row_limit"
  ],
  "properties": {
    "schema_version": {"const": "otc.portable-temporal-plan/v1"},
    "descriptor_hash": {"$ref": "#/$defs/hash"},
    "relation": {"type": "string", "minLength": 1},
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*/[1-9][0-9]*\\.[0-9]+$"
      }
    },
    "resource_bounds": {"$ref": "#/$defs/resourceBounds"},
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/scanRange"},
        {"$ref": "#/$defs/latest"},
        {"$ref": "#/$defs/asOf"},
        {"$ref": "#/$defs/bucketAggregate"},
        {"$ref": "#/$defs/gapFill"}
      ]
    },
    "output_order": {
      "type": "array",
      "items": {"$ref": "#/$defs/orderKey"}
    },
    "result_row_limit": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fieldName": {"type": "string", "minLength": 1},
    "fieldNames": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldName"},
      "uniqueItems": true
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "scalar": {
      "type": ["string", "integer", "number", "boolean"]
    },
    "resourceBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rows", "max_bytes", "max_duration_ms"],
      "properties": {
        "max_rows": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "max_duration_ms": {"type": "integer", "minimum": 1}
      }
    },
    "eqPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "values"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "operator": {"const": "eq"},
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/scalar"}
        }
      }
    },
    "inPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "values"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "operator": {"const": "in"},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scalar"}
        }
      }
    },
    "tagPredicate": {
      "oneOf": [
        {"$ref": "#/$defs/eqPredicate"},
        {"$ref": "#/$defs/inPredicate"}
      ]
    },
    "tagPredicates": {
      "type": "array",
      "items": {"$ref": "#/$defs/tagPredicate"}
    },
    "orderKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "direction": {"enum": ["asc", "desc"]}
      }
    },
    "fixedBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width_ns", "origin", "offset_ns"],
      "properties": {
        "kind": {"const": "fixed"},
        "width_ns": {"type": "integer", "minimum": 1},
        "origin": {"$ref": "#/$defs/timestamp"},
        "offset_ns": {"type": "integer"}
      }
    },
    "calendarBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count", "unit", "timezone", "week_start", "origin", "offset_ns"],
      "properties": {
        "kind": {"const": "calendar"},
        "count": {"type": "integer", "minimum": 1},
        "unit": {"enum": ["day", "week", "month", "quarter", "year"]},
        "timezone": {"type": "string", "minLength": 1},
        "week_start": {"type": "integer", "minimum": 1, "maximum": 7},
        "origin": {"$ref": "#/$defs/timestamp"},
        "offset_ns": {"type": "integer"}
      }
    },
    "bucket": {
      "oneOf": [
        {"$ref": "#/$defs/fixedBucket"},
        {"$ref": "#/$defs/calendarBucket"}
      ]
    },
    "countMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_field", "function", "value_field"],
      "properties": {
        "output_field": {"$ref": "#/$defs/fieldName"},
        "function": {"const": "count"},
        "value_field": {
          "type": "null"
        }
      }
    },
    "valueMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_field", "function", "value_field"],
      "properties": {
        "output_field": {"$ref": "#/$defs/fieldName"},
        "function": {"enum": ["min", "max", "sum", "avg", "first", "last"]},
        "value_field": {"$ref": "#/$defs/fieldName"}
      }
    },
    "measure": {
      "oneOf": [
        {"$ref": "#/$defs/countMeasure"},
        {"$ref": "#/$defs/valueMeasure"}
      ]
    },
    "constantFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "mode", "value"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "mode": {"const": "constant"},
        "value": {
          "type": ["string", "integer", "number", "boolean"]
        }
      }
    },
    "emptyFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "mode", "value"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "mode": {"enum": ["null", "locf", "linear"]},
        "value": {"type": "null"}
      }
    },
    "fill": {
      "oneOf": [
        {"$ref": "#/$defs/constantFill"},
        {"$ref": "#/$defs/emptyFill"}
      ]
    },
    "scanRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end", "projection", "tag_predicates"],
      "properties": {
        "kind": {"const": "scan_range"},
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"},
        "projection": {
          "allOf": [
            {"$ref": "#/$defs/fieldNames"},
            {"minItems": 1}
          ]
        },
        "tag_predicates": {"$ref": "#/$defs/tagPredicates"}
      }
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at_or_before", "projection", "tag_predicates"],
      "properties": {
        "kind": {"const": "latest"},
        "at_or_before": {
          "oneOf": [
            {"$ref": "#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "projection": {
          "allOf": [
            {"$ref": "#/$defs/fieldNames"},
            {"minItems": 1}
          ]
        },
        "tag_predicates": {"$ref": "#/$defs/tagPredicates"}
      }
    },
    "asOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at", "projection", "tag_predicates"],
      "properties": {
        "kind": {"const": "as_of"},
        "at": {"$ref": "#/$defs/timestamp"},
        "projection": {
          "allOf": [
            {"$ref": "#/$defs/fieldNames"},
            {"minItems": 1}
          ]
        },
        "tag_predicates": {"$ref": "#/$defs/tagPredicates"}
      }
    },
    "bucketAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end", "bucket", "group_by", "measures", "tag_predicates"],
      "properties": {
        "kind": {"const": "bucket_aggregate"},
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"},
        "bucket": {"$ref": "#/$defs/bucket"},
        "group_by": {"$ref": "#/$defs/fieldNames"},
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/measure"}
        },
        "tag_predicates": {"$ref": "#/$defs/tagPredicates"}
      }
    },
    "gapFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end", "bucket", "group_by", "measures", "tag_predicates", "fills"],
      "properties": {
        "kind": {"const": "gap_fill"},
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"},
        "bucket": {"$ref": "#/$defs/bucket"},
        "group_by": {"$ref": "#/$defs/fieldNames"},
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/measure"}
        },
        "tag_predicates": {"$ref": "#/$defs/tagPredicates"},
        "fills": {
          "type": "array",
          "items": {"$ref": "#/$defs/fill"}
        }
      }
    }
  }
}

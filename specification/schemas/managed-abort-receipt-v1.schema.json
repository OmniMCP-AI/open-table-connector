{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-connectors.dev/schemas/managed-abort-receipt-v1.schema.json",
  "title": "Managed abort receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "logical_target",
    "stage_id",
    "disposition",
    "aborted_at"
  ],
  "properties": {
    "schema_version": {"const": "otc.managed-abort-receipt/v1"},
    "operation_id": {"type": "string", "minLength": 1},
    "logical_target": {"$ref": "#/$defs/uri"},
    "stage_id": {"type": "string", "pattern": "^stage:[0-9a-f]{64}$"},
    "disposition": {"enum": ["removed", "already_absent", "already_committed"]},
    "aborted_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "uri": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {"value": {"type": "string", "minLength": 1}}
    }
  }
}

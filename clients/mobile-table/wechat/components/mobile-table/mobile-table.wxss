.mobile-table { display: flex; flex-direction: column; gap: 24rpx; color: #1f2937; font-size: 28rpx; }
.table-header, .control-row, .sync-actions, .view-tabs, .sheet-actions { display: flex; align-items: center; }
.table-header, .control-row { justify-content: space-between; gap: 16rpx; }
.title { font-size: 40rpx; font-weight: 600; }
.record-count { color: #536174; font-size: 24rpx; }
.view-tabs button, .refresh, .record-card, .sheet button { min-height: 88rpx; }
.refresh { width: 88rpx; padding: 0; font-size: 42rpx; }
.sync-actions { gap: 8rpx; color: #536174; font-size: 24rpx; }
.sync-dot { color: #2c9d71; font-size: 18rpx; }
.card-grid { display: grid; grid-template-columns: 1fr; gap: 20rpx; }
.record-card { display: flex; flex-direction: column; align-items: stretch; gap: 12rpx; padding: 24rpx; border: 1px solid #e0e6ef; border-radius: 24rpx; background: #fff; text-align: left; }
.card-field, .table-row { display: flex; }
.card-field { justify-content: space-between; color: #536174; }
.table-scroll { width: 100%; border: 1px solid #e0e6ef; border-radius: 16rpx; }
.data-table { min-width: 1440rpx; }
.table-row { min-height: 84rpx; border-bottom: 1px solid #edf0f4; }
.table-head { background: #f7f9fc; color: #536174; }
.table-cell { position: relative; box-sizing: border-box; flex: 0 0 auto; padding: 20rpx 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.resize-handle { position: absolute; top: 0; right: 0; width: 48rpx; height: 100%; padding: 0; background: transparent; border: 0; touch-action: none; }
.sheet-backdrop { position: fixed; inset: 0; display: flex; align-items: flex-end; background: rgba(16, 26, 39, .38); }
.sheet { width: 100%; max-height: 82vh; box-sizing: border-box; padding: 32rpx; border-radius: 32rpx 32rpx 0 0; background: #fff; overflow-y: auto; }
.sheet-title { display: block; margin-bottom: 24rpx; font-size: 36rpx; font-weight: 600; }
.form-field { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 20rpx; color: #536174; }
.form-field input { min-height: 88rpx; border: 1px solid #d5dce7; border-radius: 12rpx; padding: 0 20rpx; }
.sheet-actions { justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }
.sheet-actions .save { color: #fff; background: #17324d; }
@media (min-width: 768px) { .card-grid { grid-template-columns: repeat(auto-fit, minmax(420rpx, 1fr)); } }

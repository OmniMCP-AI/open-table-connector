{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OTC mobile table read page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "request_id", "table_uri", "mode", "source_revision", "fields", "rows", "next_page_token"],
  "properties": {
    "contract": {"const": "otc.mobile.table/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "table_uri": {"type": "string", "minLength": 1},
    "mode": {"enum": ["base", "sheet"]},
    "source_revision": {"type": "string", "minLength": 1},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}, "maxItems": 50},
    "rows": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/row"}},
    "next_page_token": {"type": ["string", "null"]}
  },
  "$defs": {
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "type", "nullable", "editable", "read_only_reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
        "type": {"enum": ["string", "integer", "number", "boolean", "date", "datetime", "unknown"]},
        "nullable": {"type": "boolean"}, "editable": {"type": "boolean"}, "read_only_reason": {"type": ["string", "null"]}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_revision", "values"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "record_revision": {"type": "string", "minLength": 1},
        "values": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null", "array", "object"]}}
      }
    }
  }
}

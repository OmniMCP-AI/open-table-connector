{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-connectors.dev/schemas/managed-stage-receipt-v1.schema.json",
  "title": "Managed stage receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "logical_target",
    "physical_target",
    "stage_id",
    "idempotency_key",
    "artifact_hash",
    "descriptor_hash",
    "staged_at",
    "visible"
  ],
  "properties": {
    "schema_version": {"const": "otc.managed-stage-receipt/v1"},
    "operation_id": {"type": "string", "minLength": 1},
    "logical_target": {"$ref": "#/$defs/uri"},
    "physical_target": {"$ref": "#/$defs/uri"},
    "stage_id": {"$ref": "#/$defs/stage"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "descriptor_hash": {"$ref": "#/$defs/hash"},
    "staged_at": {"$ref": "#/$defs/timestamp"},
    "visible": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stage": {"type": "string", "pattern": "^stage:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "uri": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {"value": {"type": "string", "minLength": 1}}
    }
  }
}

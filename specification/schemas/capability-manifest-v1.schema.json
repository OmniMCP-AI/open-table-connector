{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-connectors.dev/schemas/capability-manifest-v1.schema.json",
  "title": "Connector capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector", "capabilities", "modes", "uri_schemes"],
  "properties": {
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "connector_version", "contract_version"],
      "properties": {
        "connector_id": {"type": "string", "minLength": 1},
        "connector_version": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "capability_version"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "capability_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["base", "sheet"]}
    },
    "uri_schemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
